PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener
REDIS_URL=redis://localhost:6379
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Run the command twice and replace both placeholder values with separate secrets.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Public URL of this API (short links are BASE_URL/<code>)
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Optional: Google Safe Browsing API key
SAFE_BROWSING_API_KEY=
# Set to true on Render free tier to prevent spin-down (pings /api/health every 14 min)
# Remove or set to false when on a paid plan
KEEP_ALIVE_ENABLED=
